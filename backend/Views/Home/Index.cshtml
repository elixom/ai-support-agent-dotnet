<!-- Floating Web Chat Widget -->
<div id="chat-widget" class="fixed bottom-6 right-6 z-50">
    <button onclick="toggleChat()" class="w-14 h-14 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg flex items-center justify-center transition-transform hover:scale-105">
        <svg id="chat-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        <svg id="chat-icon-close" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div id="chat-window" class="hidden fixed bottom-24 right-6 w-96 h-[480px] bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col overflow-hidden">
        <div class="bg-indigo-600 px-5 py-4 flex items-center justify-between text-white">
            <div>
                <h3 class="font-bold text-sm">Demo Live Chat</h3>
                <p class="text-xs text-indigo-200">Talk to Claude Agent</p>
            </div>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        </div>
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 dark:bg-slate-900/50">
            <div class="max-w-[80%] rounded-2xl px-4 py-2 bg-white dark:bg-slate-800 text-xs text-slate-500 shadow-sm border border-slate-100 dark:border-slate-700">
                Hi! Ask me anything about our pricing plans, updates, or policies to see how the RAG compliance search works.
            </div>
        </div>
        <div class="p-3 bg-white dark:bg-slate-800 border-t border-slate-100 dark:border-slate-700 flex gap-2">
            <input id="chat-input" type="text" placeholder="Ask about Starter plan..." onkeydown="if(event.key==='Enter') sendChatMessage()" class="flex-1 bg-slate-50 dark:bg-slate-900 rounded-xl px-4 py-2 text-xs border border-slate-200 dark:border-slate-700 outline-none text-slate-900 dark:text-white" />
            <button onclick="sendChatMessage()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold">Send</button>
        </div>
    </div>
</div>

<script>
    let ws = null;
    let senderId = 'demo_' + Math.random().toString(36).substring(7);

    function toggleChat() {
        const win = document.getElementById('chat-window');
        const iconOpen = document.getElementById('chat-icon-open');
        const iconClose = document.getElementById('chat-icon-close');

        if (win.classList.contains('hidden')) {
            win.classList.remove('hidden');
            iconOpen.classList.add('hidden');
            iconClose.classList.remove('hidden');
            connectWebSocket();
        } else {
            win.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
        }
    }

    function connectWebSocket() {
        if (ws) return;
        const protocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        ws = new WebSocket(`${protocol}://${window.location.host}/ws/chat/`);

        ws.onmessage = (event) => {
            const data = JSON.parse(event.data);
            appendMessage('assistant', data.message || data.response);
        };
    }

    function sendChatMessage() {
        const inp = document.getElementById('chat-input');
        const text = inp.value.trim();
        if (!text) return;

        appendMessage('user', text);
        inp.value = '';

        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JsonStringify({ message: text, sender_id: senderId, sender_name: 'Visitor' }));
        }
    }

    function appendMessage(role, text) {
        const list = document.getElementById('chat-messages');
        const isUser = role === 'user';
        const wrapper = document.createElement('div');
        wrapper.className = `flex ${isUser ? 'justify-end' : 'justify-start'}`;

        const bubble = document.createElement('div');
        bubble.className = `max-w-[80%] rounded-2xl px-4 py-2.5 text-xs shadow-sm ${
            isUser ? 'bg-indigo-600 text-white rounded-br-sm' : 'bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-100 dark:border-slate-700 rounded-bl-sm'
        }`;
        bubble.textContent = text;

        wrapper.appendChild(bubble);
        list.appendChild(wrapper);
        list.scrollTop = list.scrollHeight;
    }

    // JSON Helper safe from standard template parsers
    function JsonStringify(obj) {
        return JSON.stringify(obj);
    }
</script>
