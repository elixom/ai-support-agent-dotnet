<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Support Agent Dashboard</title>
    <!-- Tailwind CSS 4.0 via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Apply dark mode on mount based on localStorage
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style>
        /* Smooth transitions for theme toggle */
        * {
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
    </style>
</head>
<body class="h-full bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 flex flex-col">

    <!-- Shared Navigation Wrapper -->
    <div class="flex h-full min-h-screen">

        <!-- Sidebar Navigation (Only visible when user is logged in / authenticated) -->
        <aside id="sidebar" class="hidden md:flex flex-col w-64 bg-slate-900 text-white shrink-0 border-r border-slate-800">
            <!-- Sidebar Header -->
            <div class="h-16 flex items-center px-6 border-b border-slate-800">
                <span class="text-lg font-bold text-indigo-400">AI Support Agent</span>
            </div>

            <!-- Nav Links -->
            <nav class="flex-1 px-4 py-6 space-y-1">
                <a href="/Dashboard" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    Dashboard
                </a>
                <a href="/Dashboard/Tickets" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    Tickets
                </a>
                <a href="/Dashboard/Analytics" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2h2a2 2 0 002-2zm12-3a2 2 0 00-2-2h-2a2 2 0 00-2 2v3a2 2 0 002 2h2a2 2 0 002-2v-3zm0 0V5a2 2 0 00-2-2h-2a2 2 0 00-2 2v14a2 2 0 002 2h2a2 2 0 002-2V5z"/></svg>
                    Analytics
                </a>
                <a href="/Dashboard/KnowledgeBase" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    Knowledge Base
                </a>
                <a href="/Dashboard/CannedResponses" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
                    Canned Responses
                </a>
                <a href="/Dashboard/Settings" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors text-slate-300 hover:text-white">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Settings
                </a>
            </nav>

            <!-- Sidebar Footer -->
            <div class="p-4 border-t border-slate-800 space-y-2">
                <button onclick="toggleTheme()" class="flex items-center justify-between w-full px-4 py-2 text-xs font-medium text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition-colors">
                    <span>Theme Toggle</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M14 12a2 2 0 11-8 0 2 2 0 018 0z"/></svg>
                </button>
                <button onclick="handleLogout()" class="flex items-center gap-2 w-full px-4 py-2 text-xs font-medium text-rose-400 hover:text-rose-200 rounded-lg hover:bg-rose-950/20 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Sign Out
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Header (Visible when logged in) -->
            <header id="header" class="hidden h-16 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 md:flex items-center justify-between px-8 z-10">
                <div class="flex items-center gap-4">
                    <h2 id="page-title" class="text-lg font-bold text-slate-800 dark:text-white">Dashboard</h2>
                </div>
                <div class="flex items-center gap-4">
                    <div id="user-display" class="text-sm font-medium text-slate-600 dark:text-slate-300"></div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Check local storage for JWT to conditionally show sidebar/header
        function checkAuth() {
            const token = localStorage.getItem('auth_token');
            const path = window.location.pathname;

            const isAuthPage = path.startsWith('/Auth') || path === '/' || path === '/Home';

            if (token) {
                // If logged in, show sidebar and header
                document.getElementById('sidebar')?.classList.remove('hidden');
                document.getElementById('header')?.classList.remove('hidden');
                document.getElementById('header')?.classList.add('flex');

                // Display User Email
                const userJson = localStorage.getItem('auth_user');
                if (userJson && document.getElementById('user-display')) {
                    const user = JSON.parse(userJson);
                    document.getElementById('user-display').textContent = user.email;
                }

                // If on Landing Page or Login page, redirect to Dashboard
                if (path === '/' || path === '/Auth/Login' || path === '/Auth/Signup') {
                    window.location.href = '/Dashboard';
                }
            } else {
                // If not logged in, hide sidebar and header
                document.getElementById('sidebar')?.classList.add('hidden');
                document.getElementById('header')?.classList.add('hidden');

                // If not on login/signup/landing, redirect to landing
                if (!isAuthPage) {
                    window.location.href = '/';
                }
            }
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        function handleLogout() {
            localStorage.removeItem('auth_token');
            localStorage.removeItem('auth_user');
            localStorage.removeItem('auth_team');
            window.location.href = '/';
        }

        // Run check on page mount
        checkAuth();
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
